# Base URL of the Fastify backend once it is available.
# While the backend does not exist yet, this is unused — the app runs on mock data.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Toggles the data layer. "mock" (default) uses in-memory mock services.
# Switch to "live" once the backend endpoints in lib/api/endpoints.ts are confirmed and implemented.
NEXT_PUBLIC_DATA_MODE=mock
